# Copia este archivo como .env y ajusta los valores.

# --- PostgreSQL (docker-compose.yml usa estas mismas variables) ---
POSTGRES_USER=hackaton
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=hackaton
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Servidor ---
PORT=3000

# --- JWT ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_este_secret
JWT_EXPIRES_IN=1d

# --- Administración de la plataforma ---
# Clave para endpoints de plataforma (crear instituciones). Header: X-Admin-Key
# Genera una con: openssl rand -hex 24
PLATFORM_ADMIN_KEY=cambia_esta_clave
