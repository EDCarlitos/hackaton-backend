# Copia este archivo como .env y ajusta los valores.

# --- PostgreSQL (docker-compose.yml usa estas mismas variables) ---
POSTGRES_USER=hackaton
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=hackaton
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Servidor ---
PORT=3000

# --- JWT ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_este_secret
JWT_EXPIRES_IN=1d

# --- Administración de la plataforma ---
# Clave para endpoints de plataforma (crear instituciones). Header: X-Admin-Key
# Genera una con: openssl rand -hex 24
PLATFORM_ADMIN_KEY=cambia_esta_clave

# --- Google Maps (rutas de manejo) ---
# Llave de SERVIDOR (distinta a la del frontend): restríngela por IP y habilítale solo "Routes API".
# El backend la usa una sola vez por viaje publicado (o por plantilla guardada).
# Si la dejas vacía, fuera de producción se usa un proveedor simulado (sin red).
GOOGLE_MAPS_API_KEY=
# Opcional: google | simulado. Por defecto: google si hay llave, si no simulado.
MAPS_PROVIDER=

# --- Zona horaria (para "Salgo hoy" y textos de notificaciones) ---
APP_TIMEZONE=America/Cancun

# --- Cierre automático de viajes (RF-20) ---
# Cada cuántos segundos se cierran los viajes vencidos (salida + 60 min). 0 = desactivado.
CIERRE_INTERVALO_SEG=60

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma (ej. https://rutacaribe.onrender.com).
# En desarrollo no hace falta: el frontend usa el proxy de Vite (/api → localhost:3000).
CORS_ORIGINS=
