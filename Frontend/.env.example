# Copia este archivo como .env.local (no se sube a git).

# URL del API. En desarrollo déjalo vacío: Vite manda /api/* a http://localhost:3000.
# En producción, la URL pública del backend (y agrega este origen a CORS_ORIGINS del backend).
VITE_API_URL=

# Llave de Google Maps para el NAVEGADOR: Maps JavaScript API + Places API (New) (buscar direcciones).
# Es pública: restríngela por sitio web (HTTP referrers) y solo a esas 2 APIs.
# NO es la misma llave del backend (Routes API, sin restricción de sitio web).
# Sin llave, la app dibuja las rutas en un mapa esquemático y solo se buscan los lugares frecuentes.
VITE_GOOGLE_MAPS_API_KEY=
