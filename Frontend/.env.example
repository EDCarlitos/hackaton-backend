# Copia este archivo como .env.local (no se sube a git).

# URL del API. En desarrollo déjalo vacío: Vite manda /api/* a http://localhost:3000.
# En producción, la URL pública del backend (y agrega este origen a CORS_ORIGINS del backend).
VITE_API_URL=

# Llave de Google Maps para el NAVEGADOR (Maps JavaScript API). Es pública: restríngela por dominio
# (HTTP referrers) en Google Cloud. NO es la misma llave del backend (Routes API).
# Sin llave, la app dibuja las rutas en un mapa esquemático y los lugares se eligen de una lista.
VITE_GOOGLE_MAPS_API_KEY=
