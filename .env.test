# Se carga DESPUÉS de .env al correr `npm test` y sobreescribe estos valores.
# Base de datos exclusiva para tests: se borra y se recrea en cada corrida.
NODE_ENV=test
POSTGRES_DB=hackaton_test
PLATFORM_ADMIN_KEY=clave_admin_solo_para_tests_123456
# Los tests nunca llaman a Google, aunque tu .env tenga llave.
MAPS_PROVIDER=simulado
APP_TIMEZONE=America/Cancun
