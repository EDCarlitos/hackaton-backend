{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend con Express",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:migrate": "node --env-file=.env src/db/migrate.js migrate",
    "db:seed": "node --env-file=.env src/db/migrate.js seed",
    "db:setup": "node --env-file=.env src/db/migrate.js setup",
    "pretest": "node --env-file=.env --env-file=.env.test tests/setup-db.js",
    "test": "node --env-file=.env --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
